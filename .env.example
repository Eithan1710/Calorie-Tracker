# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE secrets (never exposed to the browser).
# Used by `npm run dev` / `npm run preview` (local API) and, in production, set
# as Supabase Edge Function secrets:  supabase secrets set --env-file .env
# ─────────────────────────────────────────────────────────────────────────────

# Primary AI provider — Google Gemini API free tier (https://aistudio.google.com/apikey, no card)
GEMINI_API_KEY=
# Tried in order; a retired/renamed model (404) or exhausted quota (429) moves to the next
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash

# Fallback 1 — Groq free tier (https://console.groq.com/keys). Vision + JSON mode.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION=true

# Fallback 2 — OpenRouter free models (https://openrouter.ai/keys). `openrouter/free` routes to a currently-free vision model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Order of providers (comma-separated, skip any without a key)
AI_PROVIDER_ORDER=gemini,groq,openrouter
AI_TIMEOUT_MS=25000

# USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup) — for foods outside the built-in table.
# Leave empty to use DEMO_KEY (rate-limited). Set USDA_FDC_DISABLED=true to skip.
USDA_FDC_API_KEY=

# Edge Function access control
REQUIRE_AUTH=true
# Optional allow-list: only these emails can use the AI endpoint
ALLOWED_EMAILS=

# Web Push (daily 21:30 reminder). Optional: by default the send-reminders function
# generates the VAPID key pair on first use and keeps it (and the cron secret) in Supabase Vault.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC build-time config (VITE_ prefix → bundled into the app; nothing secret here)
# All optional: without them the app runs fully local (IndexedDB) and uses /api.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional (otherwise fetched from the send-reminders function)
VITE_VAPID_PUBLIC_KEY=
# Sub-path when hosted under /<repo>/ (GitHub Pages)
VITE_BASE=
# Override where /analyze-food lives (default: Supabase functions if configured, else /api)
VITE_API_BASE=
